# =============================================================================
# DESARPRO — Variables de entorno
# =============================================================================

# =============================================================================
# RAILWAY — Backend (https://desarpro-production.up.railway.app)
# =============================================================================

# SQLite — requiere Volume montado en /data
DATABASE_URL="file:/data/prod.db"

NODE_ENV=production
PORT=3001

# Solo el frontend real — NO usar *.vercel.app en producción
CORS_ORIGIN=https://desarpro.vercel.app

# URLs para emails y enlaces del backend
APP_URL=https://desarpro.vercel.app
FRONTEND_URL=https://desarpro.vercel.app

SESSION_TTL_MS=604800000

# Tras la primera inicialización exitosa, usar 0 en producción estable:
RUN_DB_SETUP=0
SEED_ON_START=0

# Solo al CREAR admin (no sobrescribe existente). SECRETO.
ADMIN_EMAIL=admin@desarpro.com
ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# Contraseña demo para usuarios demo al crearlos. SECRETO.
DEMO_PASSWORD=Android.13

# Flags opcionales de seed (usar con cuidado):
# SEED_RESET_PASSWORDS=1   → forzar reset contraseñas demo
# SEED_DEMO_USERS=0        → no verificar usuarios demo
# SEED_UPDATE_CONTENT=1    → sobrescribir CMS (default off en production)

# SMTP — opcional, SECRETO
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@desarpro.com

# =============================================================================
# VERCEL — Frontend (https://desarpro.vercel.app)
# =============================================================================

VITE_API_URL=https://desarpro-production.up.railway.app

# =============================================================================
# LOCAL — desarrollo (copiar a .env)
# =============================================================================
# DATABASE_URL="file:./dev.db"
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173
# APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# RUN_DB_SETUP=1
# SEED_ON_START=1
# VITE_API_URL=

# NUNCA en Vercel: DATABASE_URL, ADMIN_PASSWORD, SMTP_PASSWORD, DEMO_PASSWORD
