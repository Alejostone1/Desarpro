# ===== DesarPro — variables de entorno =====
# Copia este archivo a `.env` y ajusta los valores:
#   cp .env.example .env   (Linux/macOS)  |  copy .env.example .env   (Windows)

# --- Base de datos (Prisma + SQLite) ---
# La ruta es RELATIVA a prisma/schema.prisma. `file:./dev.db` => prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Backend Express ---
# Puerto del servidor API (3001 por defecto).
# PORT=3001

# Duración de la sesión admin en milisegundos (7 días por defecto = 604800000).
# SESSION_TTL_MS=604800000

# Orígenes permitidos por CORS, separados por coma. "*" permite cualquier
# origen (SOLO para desarrollo local). En producción lista el dominio exacto:
# CORS_ORIGIN="https://desarpro.com,https://www.desarpro.com"

# --- Usuario admin (creado/actualizado por `node seed.js`) ---
# Sin estas variables se usan los valores por defecto de desarrollo:
#   admin@desarpro.com / Administrador01  (¡cámbialos en producción!)
# ADMIN_EMAIL=admin@desarpro.com
# ADMIN_PASSWORD=

# --- Build del frontend estático (Vite) ---
# Si el deploy es estático y el backend vive en otra URL, define VITE_API_URL
# durante `vite build`. Se inyecta en <meta name="desarpro:api"> en index.html.
# Sin definir, el sitio intenta auto-detectar la API local en desarrollo.
# VITE_API_URL=https://api.desarpro.co
