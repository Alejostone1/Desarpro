# =============================================================================
# DESARPRO — Variables de entorno
# Copia: copy .env.example .env  (Windows)  |  cp .env.example .env  (Unix)
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (Prisma) — SECRETO · solo backend/Railway
# -----------------------------------------------------------------------------
# Finalidad: conexión a SQLite (local) o PostgreSQL/MySQL (producción Railway).
# Ejemplo local:  file:./dev.db
# Ejemplo prod:   postgresql://user:pass@host:5432/desarpro
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# BACKEND EXPRESS — Railway
# -----------------------------------------------------------------------------
# Puerto HTTP del servidor API.
# Público: no (solo infraestructura).
PORT=3001

# Entorno de ejecución: development | production
NODE_ENV=development

# Duración de sesión en milisegundos. Default implícito: 604800000 (7 días).
# Público: no.
SESSION_TTL_MS=604800000

# Orígenes CORS permitidos, separados por coma.
# En producción: URL exacta del frontend Vercel (sin comodín).
# Ejemplo: https://desarpro.vercel.app,https://www.desarpro.com
# Público: no (solo backend).
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# URLs PÚBLICAS — usadas en emails y redirecciones
# -----------------------------------------------------------------------------
# URL del frontend (Vercel). Links en correos de reset/aprobación.
# Público: sí (no es secreto).
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# FRONTEND VITE — Vercel (build time)
# -----------------------------------------------------------------------------
# URL base de la API en producción. Se inyecta en el build de Vite.
# Público: sí (visible en bundle del frontend).
# Local: dejar vacío o http://localhost:3001 (proxy dev)
# Producción: https://tu-app.up.railway.app
VITE_API_URL=

# Proxy backend en Vercel (vercel.json). Solo dashboard Vercel, no .env local.
# BACKEND_URL=https://tu-app.up.railway.app

# -----------------------------------------------------------------------------
# ADMIN SEED (node seed.js) — SECRETO · solo Railway/local
# -----------------------------------------------------------------------------
# Credenciales del administrador inicial creado por seed.
# Credenciales demo (seed) — SECRETO · solo desarrollo local
# Contraseña compartida para cuentas demo: super/admin/cliente
# En producción define ADMIN_PASSWORD y DEMO_PASSWORD distintos.
ADMIN_EMAIL=admin@desarpro.com
DEMO_PASSWORD=Android.13
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# SMTP / EMAIL — SECRETO · solo backend/Railway
# -----------------------------------------------------------------------------
# Si no se configuran, el sistema funciona sin enviar correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@desarpro.com
