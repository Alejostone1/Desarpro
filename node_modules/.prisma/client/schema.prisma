generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         String    @default("admin")
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// API session tokens for the admin panel (validated server-side).
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content keys that the CMS can edit (hero, stats, services, tech, process,
// cta, contact, login, footer, about, projects texts).
model ContentKey {
  id           Int                  @id @default(autoincrement())
  key          String               @unique
  section      String               @default("other")
  type         String               @default("text") // text | textarea
  order        Int                  @default(0)
  updatedAt    DateTime             @updatedAt
  translations ContentTranslation[]
}

// One row per (key, language). The five languages are es, en, pt, fr, de.
model ContentTranslation {
  id           Int        @id @default(autoincrement())
  contentKeyId Int
  lang         String
  value        String     @default("")
  updatedAt    DateTime   @updatedAt
  contentKey   ContentKey @relation(fields: [contentKeyId], references: [id], onDelete: Cascade)

  @@unique([contentKeyId, lang])
  @@index([lang])
}

model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  industry     String
  title        String
  client       String?
  year         String
  color        String
  icon         String
  tagline      String
  desc         String
  tags         String               @default("[]")
  metrics      String               @default("[]")
  featured     Boolean              @default(false)
  active       Boolean              @default(true)
  order        Int                  @default(0)
  translations ProjectTranslation[]

  @@index([active])
  @@index([featured])
}

// Per-language text for each project (title, tagline, desc). Missing
// languages fall back to the canonical values stored on Project.
model ProjectTranslation {
  id        Int     @id @default(autoincrement())
  projectId Int
  lang      String
  title     String  @default("")
  tagline   String  @default("")
  desc      String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
}

// Contact form submissions / sales leads. status flow:
// new -> contacted -> in_progress -> won | lost
model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String   @default("")
  company   String   @default("")
  service   String   @default("")
  budget    String   @default("")
  message   String   @default("")
  status    String   @default("new") // new | contacted | in_progress | won | lost
  notes     String   @default("")
  source    String   @default("contact") // contact | manual
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Services catalog (12 services). `featured` marks the 6 core services shown
// on the home preview; the rest are "specialized". Text lives per-language in
// ServiceTranslation (bullets/deliverables/process are JSON arrays).
model Service {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique // svc-web
  kind         String               @unique // web
  icon         String               @default("Layers")
  color        String               @default("#22D3EE")
  featured     Boolean              @default(false)
  active       Boolean              @default(true)
  order        Int                  @default(0)
  translations ServiceTranslation[]

  @@index([active])
  @@index([featured])
}

model ServiceTranslation {
  id           Int     @id @default(autoincrement())
  serviceId    Int
  lang         String
  name         String  @default("")
  tagline      String  @default("")
  overview     String  @default("")
  bullets      String  @default("[]") // JSON array
  deliverables String  @default("[]") // JSON array
  process      String  @default("[]") // JSON array
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, lang])
}

// Technologies marquee (TechLoop). Icons are rendered client-side from the
// bundled TECH_LOGOS map; the DB stores which are active/ordered/categorized.
model Technology {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  color    String  @default("#22D3EE")
  category String  @default("Otros") // Frontend | Backend | Cloud | Data | DevOps | Mobile | Diseño | IA
  featured Boolean @default(true)
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([active])
}

// Per-route, per-language SEO metadata (title, description, keywords, OG).
model SeoEntry {
  id            Int      @id @default(autoincrement())
  route         String // home | servicios | svc-web | proyectos | nosotros | contacto | 404
  lang          String
  title         String   @default("")
  description   String   @default("")
  keywords      String   @default("")
  ogTitle       String   @default("")
  ogDescription String   @default("")
  ogImage       String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([route, lang])
}

// Site-wide settings (section visibility, hero image, announcement, contact
// details). `value` is a JSON object keyed by setting name.
model SiteConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique // sections | heroImage | announcement | contact
  value String @default("{}")
}

// Automatic backups taken before destructive operations (e.g. reset).
model ContentSnapshot {
  id        Int      @id @default(autoincrement())
  kind      String   @default("backup") // backup | reset-before | import-before
  data      String // JSON: { content, projects, services, technologies }
  createdAt DateTime @default(now())
}
