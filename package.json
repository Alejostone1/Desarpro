{
  "name": "desarpro-full",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server.js\"",
    "build": "node ./node_modules/vite/bin/vite.js build && node copy-build-assets.js",
    "preview": "vite preview",
    "db:migrate": "prisma migrate dev --name cms",
    "db:push": "prisma db push",
    "db:seed": "node seed.js"
  },
  "prisma": {
    "seed": "node seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "concurrently": "^9.2.4",
    "express": "^5.2.1",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  }
}
