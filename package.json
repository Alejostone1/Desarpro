{
  "name": "desarpro-full",
  "private": true,
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server.js\"",
    "build": "node ./node_modules/vite/bin/vite.js build && node copy-build-assets.js && node scripts/inject-api-url.js",
    "preview": "vite preview",
    "start": "node server.js",
    "start:api": "node scripts/start-api.js",
    "postinstall": "node scripts/postinstall.js",
    "db:migrate": "prisma migrate dev --name cms",
    "db:push": "prisma db push",
    "db:seed": "node seed.js",
    "test:smoke": "node smoke-test.js",
    "i18n:check": "node scripts/i18n-parity-check.js",
    "test:e2e:admin": "node scripts/admin-verify.js",
    "test:e2e:browser": "node scripts/browser-test.js",
    "verify:prod": "node scripts/verify-production.js",
    "build:local": "node scripts/build-local.js"
  },
  "prisma": {
    "seed": "node seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "concurrently": "^9.2.4",
    "express": "^5.2.1",
    "nodemailer": "^6.9.16",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  }
}
