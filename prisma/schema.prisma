generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id                 Int              @id @default(autoincrement())
  email              String           @unique
  passwordHash       String
  role               String           @default("client") // super_admin | admin | client
  status             String           @default("ACTIVE") // ACTIVE | PENDING | REJECTED | SUSPENDED | INACTIVE | BLOCKED
  firstName          String           @default("")
  lastName           String           @default("")
  phone              String           @default("")
  company            String           @default("")
  jobTitle           String           @default("")
  permissions        String           @default("[]")
  mustChangePassword Boolean          @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  sessions           Session[]
  clientProjects     ClientProject[]  @relation("ClientProjects")
  assignedProjects   ClientProject[]  @relation("AssignedProjects")
  conversations      Conversation[]   @relation("ClientConversations")
  sentMessages       Message[]        @relation("SentMessages")
  convertedLeads     Lead[]           @relation("ConvertedLeads")
  activityLogs       ActivityLog[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([status])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClientProject {
  id           Int            @id @default(autoincrement())
  clientId     Int
  client       User           @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  assigneeId   Int?
  assignee     User?          @relation("AssignedProjects", fields: [assigneeId], references: [id], onDelete: SetNull)
  title        String
  description  String         @default("")
  status       String         @default("PLANNING")
  priority     String         @default("MEDIUM")
  progress     Int            @default(0)
  technologies String         @default("[]")
  deliverables String         @default("[]")
  milestones   String         @default("[]")
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  conversations Conversation[]
  files         ProjectDeliverable[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
}

model ProjectDeliverable {
  id          Int           @id @default(autoincrement())
  projectId   Int
  project     ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  url         String        @default("")
  visible     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
  @@index([visible])
}

model Webhook {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  event     String
  active    Boolean  @default(true)
  secret    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([event])
  @@index([active])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  readAt    DateTime?
  meta      String    @default("{}")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model Conversation {
  id            Int            @id @default(autoincrement())
  clientId      Int
  client        User           @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  projectId     Int?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subject       String         @default("")
  lastMessageAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  messages      Message[]

  @@index([clientId])
  @@index([lastMessageAt])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  meta      String   @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Content keys that the CMS can edit (hero, stats, services, tech, process,
// cta, contact, login, footer, about, projects texts).
model ContentKey {
  id           Int                   @id @default(autoincrement())
  key          String                @unique
  section      String                @default("other")
  type         String                @default("text") // text | textarea
  order        Int                   @default(0)
  updatedAt    DateTime              @updatedAt
  translations ContentTranslation[]
}

model ContentTranslation {
  id           Int        @id @default(autoincrement())
  contentKeyId Int
  lang         String
  value        String     @default("")
  updatedAt    DateTime   @updatedAt
  contentKey   ContentKey @relation(fields: [contentKeyId], references: [id], onDelete: Cascade)

  @@unique([contentKeyId, lang])
  @@index([lang])
}

model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  industry     String
  title        String
  client       String?
  year         String
  color        String
  icon         String
  tagline      String
  desc         String
  tags         String               @default("[]")
  metrics      String               @default("[]")
  featured     Boolean              @default(false)
  active       Boolean              @default(true)
  order        Int                  @default(0)
  translations ProjectTranslation[]

  @@index([active])
  @@index([featured])
}

model ProjectTranslation {
  id        Int     @id @default(autoincrement())
  projectId Int
  lang      String
  title     String  @default("")
  tagline   String  @default("")
  desc      String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
}

model Lead {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  phone           String   @default("")
  company         String   @default("")
  service         String   @default("")
  budget          String   @default("")
  message         String   @default("")
  status          String   @default("new")
  notes           String   @default("")
  source          String   @default("contact")
  convertedUserId Int?
  convertedUser   User?    @relation("ConvertedLeads", fields: [convertedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model Service {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  kind         String               @unique
  icon         String               @default("Layers")
  color        String               @default("#22D3EE")
  featured     Boolean              @default(false)
  active       Boolean              @default(true)
  order        Int                  @default(0)
  translations ServiceTranslation[]

  @@index([active])
  @@index([featured])
}

model ServiceTranslation {
  id           Int     @id @default(autoincrement())
  serviceId    Int
  lang         String
  name         String  @default("")
  tagline      String  @default("")
  overview     String  @default("")
  bullets      String  @default("[]")
  deliverables String  @default("[]")
  process      String  @default("[]")
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, lang])
}

model Technology {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  color    String  @default("#22D3EE")
  category String  @default("Otros")
  featured Boolean @default(true)
  active   Boolean @default(true)
  order    Int     @default(0)

  @@index([active])
}

model SeoEntry {
  id            Int      @id @default(autoincrement())
  route         String
  lang          String
  title         String   @default("")
  description   String   @default("")
  keywords      String   @default("")
  ogTitle       String   @default("")
  ogDescription String   @default("")
  ogImage       String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([route, lang])
}

model SiteConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @default("{}")
}

model ContentSnapshot {
  id        Int      @id @default(autoincrement())
  kind      String   @default("backup")
  data      String
  createdAt DateTime @default(now())
}
