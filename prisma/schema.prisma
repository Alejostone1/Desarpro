generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         String    @default("admin")
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

// API session tokens for the admin panel (validated server-side).
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content keys that the CMS can edit (hero, stats, services, tech, process,
// cta, contact, login, footer, about, projects texts).
model ContentKey {
  id           Int                   @id @default(autoincrement())
  key          String                @unique
  section      String                @default("other")
  type         String                @default("text") // text | textarea
  order        Int                   @default(0)
  updatedAt    DateTime              @updatedAt
  translations ContentTranslation[]
}

// One row per (key, language). The five languages are es, en, pt, fr, de.
model ContentTranslation {
  id           Int        @id @default(autoincrement())
  contentKeyId Int
  lang         String
  value        String     @default("")
  updatedAt    DateTime   @updatedAt
  contentKey   ContentKey @relation(fields: [contentKeyId], references: [id], onDelete: Cascade)

  @@unique([contentKeyId, lang])
  @@index([lang])
}

model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  industry     String
  title        String
  client       String?
  year         String
  color        String
  icon         String
  tagline      String
  desc         String
  tags         String               @default("[]")
  metrics      String               @default("[]")
  featured     Boolean              @default(false)
  active       Boolean              @default(true)
  order        Int                  @default(0)
  translations ProjectTranslation[]

  @@index([active])
  @@index([featured])
}

// Per-language text for each project (title, tagline, desc). Missing
// languages fall back to the canonical values stored on Project.
model ProjectTranslation {
  id        Int     @id @default(autoincrement())
  projectId Int
  lang      String
  title     String  @default("")
  tagline   String  @default("")
  desc      String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
}

// Automatic backups taken before destructive operations (e.g. reset).
model ContentSnapshot {
  id        Int      @id @default(autoincrement())
  kind      String   @default("backup") // backup | reset-before | import-before
  data      String   // JSON: { content, projects }
  createdAt DateTime @default(now())
}
